      "source": [
        "%%writefile tamagotchi.py\n",
        "from alimento import Alimento\n",
        "from brinquedo import Brinquedo\n",
        "from inventario import Inventario\n",
        "\n",
        "\n",
        "class Tamagotchi:\n",
        "    def __init__(self, nome):\n",
        "        self.nome = nome\n",
        "        self.idade = 0\n",
        "        self.idade_maxima = 10\n",
        "        self.ativo = True\n",
        "        self.__energia = 100\n",
        "        self.__fome = 50\n",
        "        self.__humor = 100\n",
        "\n",
        "        # composição: o Tamagotchi tem um Inventario\n",
        "        self.mochila = Inventario()\n",
        "\n",
        "    @property\n",
        "    def energia(self):\n",
        "        return self.__energia\n",
        "\n",
        "    @energia.setter\n",
        "    def energia(self, valor):\n",
        "        if valor < 0 or valor > 100:\n",
        "            raise ValueError(\"A energia deve ficar entre 0 e 100.\")\n",
        "        self.__energia = valor\n",
        "\n",
        "    @property\n",
        "    def fome(self):\n",
        "        return self.__fome\n",
        "\n",
        "    @fome.setter\n",
        "    def fome(self, valor):\n",
        "        if valor < 0 or valor > 100:\n",
        "            raise ValueError(\"A fome deve ficar entre 0 e 100.\")\n",
        "        self.__fome = valor\n",
        "\n",
        "    @property\n",
        "    def humor(self):\n",
        "        return self.__humor\n",
        "\n",
        "    @humor.setter\n",
        "    def humor(self, valor):\n",
        "        if valor < 0 or valor > 100:\n",
        "            raise ValueError(\"O humor deve ficar entre 0 e 100.\")\n",
        "        self.__humor = valor\n",
        "\n",
        "    def alimentar(self, nome_alimento):\n",
        "        if not self.ativo:\n",
        "            return \"O mascote está inativo.\"\n",
        "\n",
        "        for item in self.mochila.lista_de_itens:\n",
        "            if isinstance(item, Alimento) and item.nome == nome_alimento:\n",
        "                self.fome = max(0, self.fome - item.saciedade)\n",
        "                self.energia = min(100, self.energia + item.calorias)\n",
        "                self.mochila.remover_item(item)\n",
        "                return f\"{self.nome} comeu {item.nome}.\"\n",
        "\n",
        "        return \"Alimento não encontrado.\"\n",
        "\n",
        "    def brincar(self, nome_brinquedo):\n",
        "        if not self.ativo:\n",
        "            return \"O mascote está inativo.\"\n",
        "\n",
        "        for item in self.mochila.lista_de_itens:\n",
        "            if isinstance(item, Brinquedo) and item.nome == nome_brinquedo:\n",
        "                if self.energia < item.gasto_calorias:\n",
        "                    return \"Energia insuficiente para brincar.\"\n",
        "\n",
        "                self.energia = self.energia - item.gasto_calorias\n",
        "                self.humor = min(100, self.humor + item.nivel_diversao)\n",
        "                item.durabilidade = item.durabilidade - 1\n",
        "\n",
        "                if item.durabilidade == 0:\n",
        "                    self.mochila.remover_item(item)\n",
        "\n",
        "                return f\"{self.nome} brincou com {item.nome}.\"\n",
        "\n",
        "        return \"Brinquedo não encontrado.\"\n",
        "\n",
        "    def dormir(self):\n",
        "        if not self.ativo:\n",
        "            return \"O mascote está inativo.\"\n",
        "\n",
        "        self.energia = min(100, self.energia + 30)\n",
        "        self.fome = min(100, self.fome + 10)\n",
        "        return f\"{self.nome} dormiu.\"\n",
        "\n",
        "    def envelhecer(self):\n",
        "        if not self.ativo:\n",
        "            return\n",
        "\n",
        "        self.idade = self.idade + 1\n",
        "        self.energia = max(0, self.energia - 10)\n",
        "        self.fome = min(100, self.fome + 10)\n",
        "        print(f\"{self.nome} envelheceu. Idade: {self.idade}\")\n",
        "\n",
        "        if self.idade == self.idade_maxima:\n",
        "            self.ativo = False\n",
        "            print(\"GAME OVER\")\n",
        "\n",
        "    def status_critico(self):\n",
        "        return self.energia <= 20 or self.fome >= 80 or self.humor <= 20\n",
        "\n",
        "    def exibir_status(self):\n",
        "        print(\"\\n--- STATUS ---\")\n",
        "        print(\"Nome:\", self.nome)\n",
        "        print(\"Idade:\", self.idade)\n",
        "        print(\"Energia:\", self.energia)\n",
        "        print(\"Fome:\", self.fome)\n",
        "        print(\"Humor:\", self.humor)"
      ],
