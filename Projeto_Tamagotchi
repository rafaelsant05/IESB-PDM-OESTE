        "%%writefile tempo_vida.py\n",
        "import time\n",
        "import threading\n",
        "\n",
        "\n",
        "class TempoVida:\n",
        "    def __init__(self, mascote, intervalo=120):\n",
        "        self.mascote = mascote\n",
        "        self.intervalo = intervalo\n",
        "        self.rodando = False\n",
        "\n",
        "    def iniciar(self):\n",
        "        self.rodando = True\n",
        "        threading.Thread(target=self.contar, daemon=True).start()\n",
        "\n",
        "    def contar(self):\n",
        "        while self.rodando and self.mascote.ativo:\n",
        "            time.sleep(self.intervalo)\n",
        "            if self.rodando:\n",
        "                self.mascote.envelhecer()\n",
        "\n",
        "    def parar(self):\n",
        "        self.rodando = False"
      ],
      "id": "u4_ah0PHoeOt"
