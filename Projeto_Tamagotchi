        "%%writefile inventario.py\n",
        "class Inventario:\n",
        "    def __init__(self, capacidade_maxima=10):\n",
        "        self.capacidade_maxima = capacidade_maxima\n",
        "        self.lista_de_itens = []\n",
        "\n",
        "    def adicionar_item(self, item):\n",
        "        if len(self.lista_de_itens) < self.capacidade_maxima:\n",
        "            self.lista_de_itens.append(item)\n",
        "        else:\n",
        "            print(\"Mochila cheia.\")\n",
        "\n",
        "    def remover_item(self, item):\n",
        "        self.lista_de_itens.remove(item)"
